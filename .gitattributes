# Auto detect text files and perform LF normalization
* text=auto

# Anything the Linux runners execute must be LF, always, regardless of anyone's local
# core.autocrlf. A shell script checked out with CRLF fails on bash with `$'\r': command not
# found` — a message that points at the line after the real problem and takes an hour to
# recognise. `eol=lf` pins the working-tree ending too, not just what is stored.
*.sh text eol=lf
*.sql text eol=lf
.github/**/*.yml text eol=lf

# The vendored charting library is checked against a pinned SHA256 (scripts/
# vendor_lightweight_charts.py, and tests/dashboard/test_static.py). `* text=auto` above would
# rewrite its line endings on a Windows checkout, changing every line and therefore the hash —
# so the file that is verified byte for byte is stored and checked out byte for byte.
fxagent/dashboard/static/vendor/** binary
