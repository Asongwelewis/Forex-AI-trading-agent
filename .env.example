# Copy to .env and fill in. NEVER commit .env.
# Demo accounts only — see CLAUDE.md hard rule 1.

# =====================================================================
# EXECUTION — MetaTrader 5 / Exness demo.
#
# MT5 is the EXECUTION VENUE ONLY. It places, reads and closes orders.
# It is no longer the source of market data — see the DATA section below.
# Everything here belongs to the process that actually talks to the
# terminal; a collector or analyst service needs none of it.
# =====================================================================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOLS=EURUSD,GBPUSD,EURGBP

# Exness suffixes symbols by account type: EURUSD becomes EURUSDm or EURUSDz.
# Check the exact name in the terminal's Market Watch. Leave blank if there is none.
MT5_SYMBOL_SUFFIX=

# Symbol the broker clock is read from. Detection needs a LIVE quote, so point this at a
# 24/7 instrument (a crypto CFD) and the offset stays readable at weekends, when every FX
# symbol's most recent tick is stale by definition. Defaults to the first MT5_SYMBOLS entry.
MT5_CLOCK_SYMBOL=BTCUSD

# MT5 reports times on the BROKER's clock, not UTC. Detected automatically on connect.
# Set it explicitly only to skip detection entirely.
# Exness demo measures UTC+0, so 0 — verified twice, and unusual: most brokers run 2 or 3.
MT5_SERVER_UTC_OFFSET_HOURS=

# Only needed when several terminals are installed; path to terminal64.exe.
MT5_TERMINAL_PATH=

# Maximum market-order slippage in points.
MT5_DEVIATION_POINTS=20

# =====================================================================
# DATA — market and calendar inputs.
#
# The economic calendar comes from Forex Factory's free weekly JSON feed,
# which needs no API key. It DOES require a User-Agent header: without one
# the host returns HTTP 429. Set one that identifies this agent.
#   https://nfs.faireconomy.media/ff_calendar_thisweek.json
# =====================================================================
CALENDAR_USER_AGENT=fx-regime-agent/0.1

# Twelve Data — historical backfill and the daily cross-check. Free tier: 800 credits/day
# and 8/minute, both enforced locally so a backfill stops cleanly instead of being
# throttled part-way through a write. Free key: https://twelvedata.com/pricing
TWELVEDATA_API_KEY=


# =====================================================================
# STORE — Supabase Postgres + pgvector.
#
# Both the collector and the analyst read and write here; it is the shared
# record that survives a power cut at home. Setup:
#   1. Create the project (free tier is enough to start).
#   2. Copy the project URL and the service role key from Settings > API.
#   3. Fill in the two values below.
#   4. In the SQL editor run: create extension if not exists vector;
#
# SUPABASE_SERVICE_KEY is the SERVICE ROLE key. It bypasses Row Level
# Security entirely and is effectively a database superuser credential.
# Server-side services only — it must never reach the dashboard front end,
# a browser, or any log line. Use the anon key for anything user-facing.
# =====================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The two above are PostgREST credentials. The store does NOT use them — it speaks the Postgres
# wire protocol directly (see docs/ADR-001-store.md), which needs a real DSN:
#
#   Supabase > Settings > Database > Connection string > URI
#
# Prefer the SESSION POOLER (port 5432 on *.pooler.supabase.com). Supabase's direct database
# host is IPv6-only and GitHub-hosted Actions runners have no IPv6, so the direct string works
# on a laptop and fails in every scheduled run. Port 6543 is the transaction pooler; it
# also works — prepared statements are disabled for it automatically — but is second choice.
#
# Paste it unmodified, INCLUDING the `?sslmode=require` suffix — it is translated for
# asyncpg on load, and it is not optional. Supabase's pooler serves a self-signed
# certificate on the Postgres port, so a URL with no sslmode gets full verification and
# fails with "self-signed certificate in certificate chain". `require` encrypts without
# verifying, which is what Supabase's own string asks for. For verification as well, install
# Supabase's CA certificate and use `?sslmode=verify-full`.
SUPABASE_DB_URL=

# Local Postgres fallback, used only when SUPABASE_DB_URL is unset. Tests use
# TEST_DATABASE_URL instead and never touch the Supabase project.
DATABASE_URL=

# =====================================================================
# LLM — narration only. The agents explain decisions and never make one.
#
# All three are OPTIONAL. With none of them set, every narration falls
# back to the deterministic template in fxagent/agents/templates.py and
# the pass completes normally — same as when a provider is down, rate
# limits out, or returns something that fails validation.
#
# Routing is via LiteLLM, which is an optional extra:
#   uv sync --extra llm
# Without it installed, narration templates just as it does with no keys.
#
# The chain is a table in fxagent/agents/gateway.py and is walked in
# order until one provider answers. A fourth provider is a row there plus
# a key here — the two variables below only reorder the front of it, and
# nothing is dropped by being left out of them.
# =====================================================================
GEMINI_API_KEY=
GROQ_API_KEY=

# NVIDIA NIM, via https://integrate.api.nvidia.com/v1 — the risk officer's
# provider. Free, but it needs Developer Program membership and a verified
# phone number, so leaving this blank is the normal state.
#
# One key configures THREE rungs of the chain: deepseek-v4-pro, Nemotron 3
# Ultra and GLM-5.2, all on that one endpoint. That is deliberate — the
# endpoint has been reported returning internal server errors on trivial
# prompts, and a single entry would make that a total outage of this agent's
# provider. A 500 falls straight to the next rung.
#
# The model slugs are in fxagent/agents/gateway.py, checked against each
# model's own hosted code sample on build.nvidia.com (17 Aug 2026). Two of
# them are easy to get wrong: it is nvidia/nemotron-3-ultra-550b-a55b, not
# the shorter nvidia/nemotron-3-ultra used by the SELF-HOSTED NIM docs; and
# z-ai/glm-5.2, not zai-org/glm-5.2, which is the NGC container team rather
# than the API namespace. A wrong slug fails as an ordinary provider error
# and falls quietly to the next rung, so re-check against the model URL.
NVIDIA_API_KEY=

LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# =====================================================================
# ALERTS
# =====================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =====================================================================
# RISK
# =====================================================================
RISK_PER_TRADE=0.005
MAX_TOTAL_RISK=0.02
DAILY_LOSS_LIMIT=0.03

# =====================================================================
# RUNTIME
# =====================================================================
LOG_LEVEL=INFO
JOURNAL_DB_PATH=./data/journal.db
TRADING_MODE=advisory

# =====================================================================
# DASHBOARD — read-only panel. Needs SUPABASE_DB_URL above and nothing else.
# =====================================================================
# Bound on every interface on purpose: the point is to reach it from another machine. There is
# no authentication, and the mitigation is that no route can change anything — see ADR-004.
FX_DASHBOARD_HOST=0.0.0.0
FX_DASHBOARD_PORT=8080

# How often a *watched* view is rebuilt server-side. Nothing is pushed unless its content hash
# moved, so this is the latency on a new bar appearing, not a message rate. The analyst writes
# hourly, so there is little to gain below ~10s. Under `poll` it is also the client's interval.
FX_DASHBOARD_REFRESH_SECONDS=15

# How updates reach the browser. `ws` (default) is one socket and one shared server-side
# rebuild, and needs a host that runs a process. `poll` is a conditional GET on a timer and is
# the only thing that works on a serverless host — it costs a database read per viewer per
# tick, so set it only where a socket genuinely cannot be held open. See ADR-004.
FX_DASHBOARD_TRANSPORT=ws

# A shared password (HTTP Basic, any username). Unset means the panel is open, which is right on
# localhost and on a private network and wrong on a public URL. Startup logs which one you have.
FX_DASHBOARD_PASSWORD=
