# Copy to .env and fill in. NEVER commit .env.
# Demo accounts only — see CLAUDE.md hard rule 1.

# =====================================================================
# EXECUTION — MetaTrader 5 / Exness demo.
#
# MT5 is the EXECUTION VENUE ONLY. It places, reads and closes orders.
# It is no longer the source of market data — see the DATA section below.
# Everything here belongs to the process that actually talks to the
# terminal; a collector or analyst service needs none of it.
# =====================================================================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOLS=EURUSD,GBPUSD,EURGBP

# Exness suffixes symbols by account type: EURUSD becomes EURUSDm or EURUSDz.
# Check the exact name in the terminal's Market Watch. Leave blank if there is none.
MT5_SYMBOL_SUFFIX=

# Symbol the broker clock is read from. Detection needs a LIVE quote, so point this at a
# 24/7 instrument (a crypto CFD) and the offset stays readable at weekends, when every FX
# symbol's most recent tick is stale by definition. Defaults to the first MT5_SYMBOLS entry.
MT5_CLOCK_SYMBOL=BTCUSD

# MT5 reports times on the BROKER's clock, not UTC. Detected automatically on connect.
# Set it explicitly only to skip detection entirely.
# Exness demo measures UTC+0, so 0 — verified twice, and unusual: most brokers run 2 or 3.
MT5_SERVER_UTC_OFFSET_HOURS=

# Only needed when several terminals are installed; path to terminal64.exe.
MT5_TERMINAL_PATH=

# Maximum market-order slippage in points.
MT5_DEVIATION_POINTS=20

# =====================================================================
# DATA — market and calendar inputs.
#
# The economic calendar comes from Forex Factory's free weekly JSON feed,
# which needs no API key. It DOES require a User-Agent header: without one
# the host returns HTTP 429. Set one that identifies this agent.
#   https://nfs.faireconomy.media/ff_calendar_thisweek.json
# =====================================================================
CALENDAR_USER_AGENT=fx-regime-agent/0.1

# =====================================================================
# STORE — Supabase Postgres + pgvector.
#
# Both the collector and the analyst read and write here; it is the shared
# record that survives a power cut at home. Setup:
#   1. Create the project (free tier is enough to start).
#   2. Copy the project URL and the service role key from Settings > API.
#   3. Fill in the two values below.
#   4. In the SQL editor run: create extension if not exists vector;
#
# SUPABASE_SERVICE_KEY is the SERVICE ROLE key. It bypasses Row Level
# Security entirely and is effectively a database superuser credential.
# Server-side services only — it must never reach the dashboard front end,
# a browser, or any log line. Use the anon key for anything user-facing.
# =====================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The two above are PostgREST credentials. The store does NOT use them — it speaks the Postgres
# wire protocol directly (see docs/ADR-001-store.md), which needs a real DSN:
#
#   Supabase > Settings > Database > Connection string > URI
#
# Prefer the SESSION POOLER (port 5432 on *.pooler.supabase.com). Supabase's direct database
# host is IPv6-only and Oracle Always Free ARM instances often have no IPv6, so the direct
# string works on a laptop and fails on the server. Port 6543 is the transaction pooler; it
# also works — prepared statements are disabled for it automatically — but is second choice.
#
# Paste it unmodified, INCLUDING the `?sslmode=require` suffix — it is translated for
# asyncpg on load, and it is not optional. Supabase's pooler serves a self-signed
# certificate on the Postgres port, so a URL with no sslmode gets full verification and
# fails with "self-signed certificate in certificate chain". `require` encrypts without
# verifying, which is what Supabase's own string asks for. For verification as well, install
# Supabase's CA certificate and use `?sslmode=verify-full`.
SUPABASE_DB_URL=

# Local Postgres fallback, used only when SUPABASE_DB_URL is unset. Tests use
# TEST_DATABASE_URL instead and never touch the Supabase project.
DATABASE_URL=

# =====================================================================
# LLM
# =====================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# =====================================================================
# ALERTS
# =====================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =====================================================================
# RISK
# =====================================================================
RISK_PER_TRADE=0.005
MAX_TOTAL_RISK=0.02
DAILY_LOSS_LIMIT=0.03

# =====================================================================
# RUNTIME
# =====================================================================
LOG_LEVEL=INFO
JOURNAL_DB_PATH=./data/journal.db
TRADING_MODE=advisory
